# Secret used to sign and verify the HS256 session JWT.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
# Must be at least 32 characters; src/lib/session.ts throws at startup otherwise.
JWT_SECRET=

# Optional. Session lifetime in seconds (default 3600). Set it below 600 to make
# every request cross the sliding-session refresh threshold — handy for demos.
# SESSION_TTL_SECONDS=3600
